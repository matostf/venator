# Copy to .env. Every key is optional: without it the corresponding source is
# skipped and the CLI says so. Wikimedia Commons, The Met, the Art Institute of
# Chicago, Gallica/BnF and the Library of Congress need no key at all.

# Smithsonian Open Access — free key: https://api.data.gov/signup/
SMITHSONIAN_API_KEY=

# Europeana — free key: https://pro.europeana.eu/page/get-api
EUROPEANA_API_KEY=

# DPLA (scripts/acervos.py) — free key: POST https://api.dp.la/v2/api_key/<your-email>
DPLA_API_KEY=
