# Copy to .env for local development.

# Password to access the library. If empty, auth is OFF (local dev convenience).
APP_PASSWORD=

# Signs the session cookie. Use a long random value in production.
SECRET_KEY=dev-insecure-secret-change-me

# Optional: where the SQLite db + images live. Defaults to ./data locally.
# DATA_DIR=./data

# Optional: free key for the Smithsonian source (https://api.data.gov/signup/).
# Without it, the Smithsonian source is shown as "not ready".
SMITHSONIAN_API_KEY=

# Optional: free key for the Europeana source (https://pro.europeana.eu/page/get-api).
# Without it, the Europeana source is shown as "not ready".
EUROPEANA_API_KEY=
