# Copy to .env for local development.

# Master/admin password AND the auth on/off switch. If empty, auth is OFF
# (local dev convenience) and the app is fully open. If set, login is required:
# users sign in with their own e-mail/password account, and this value also
# works as a master password so an admin always has a way in.
APP_PASSWORD=

# Signs the session cookie. Use a long random value in production.
SECRET_KEY=dev-insecure-secret-change-me

# Optional: where the SQLite db + images live. Defaults to ./data locally.
# DATA_DIR=./data

# Public base URL, used to build absolute password-reset links in e-mails.
# Falls back to the request host if unset. e.g. https://acervo-historia-matostf.fly.dev
# APP_BASE_URL=

# SMTP settings for sending password-reset e-mails. With SMTP_HOST unset, the
# reset link is logged to the server console (and shown on the page) instead.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Acervo de História <you@example.com>
# SMTP_STARTTLS=true        # default true (use STARTTLS on port 587)
# SMTP_SSL=false            # set true for implicit SSL (port 465)

# Optional: free key for the Smithsonian source (https://api.data.gov/signup/).
# Without it, the Smithsonian source is shown as "not ready".
SMITHSONIAN_API_KEY=
